# ibookfs Configuration Example
# Copy this file to config.yaml and modify as needed.
# Environment variables override these values.

server:
  address: ":8080"
  baseURL: "http://localhost"  # Base URL for static assets (email logo, etc.)
  allowedOrigins:
    - "http://localhost:3000"
    - "http://localhost:8080"
  skipAuthPaths:
    - "/health"
    - "/api/v1/auth/send-code"
    - "/api/v1/auth/login"
    - "/api/v1/auth/register"
    - "/api/v1/auth/oauth/authorize"
    - "/api/v1/auth/oauth/callback"
    - "/api/v1/auth/refresh"

database:
  # kind: sqlite or mysql
  kind: sqlite
  # SQLite settings
  path: "ibookfs.db"
  
  # MySQL settings (uncomment to use MySQL)
  # kind: mysql
  # host: "localhost"
  # port: "3306"
  # user: "mgcis"
  # password: "your_password"
  # name: "ibookfs"

jwt:
  secret: "your-secret-key-change-in-production"
  expiration: 24  # token expiration in hours

oauth:
  github:
    client_id: "your-github-client-id"
    client_secret: "your-github-client-secret"
    redirect_url: "http://localhost:5173/auth/callback"

  gitee:
    client_id: "your-gitee-client-id"
    client_secret: "your-gitee-client-secret"
    redirect_url: "http://localhost:5173/auth/callback"

email:
  # kind: netease, smtp, or disabled
  kind: netease
  host: "smtp.qiye.163.com"
  port: 465
  user: "demo@ibookfs.cn"
  password: "123456"
  from: "demo@ibookfs.cn"
  from_name: "iBookFS"

  # For generic SMTP, set kind: smtp and configure accordingly
  # kind: smtp
  # host: "smtp.gmail.com"
  # port: 587
  # user: "your-email@gmail.com"
  # password: "your-app-password"
  # from: "your-email@gmail.com"
  # from_name: "iBookFS"
